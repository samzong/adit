{
  "name": "adit",
  "version": "0.2.0",
  "description": "A local macOS shell for resumable LLM web conversation entrances.",
  "author": "Samzong",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "pack:mac": "pnpm rebuild:electron && pnpm build && electron-builder --mac --dir --publish never",
    "dist:mac:arm64": "pnpm rebuild:electron && pnpm build && electron-builder --mac dmg --arm64 --publish never",
    "preview": "pnpm rebuild:electron && electron-vite preview",
    "postinstall": "pnpm rebuild:electron",
    "rebuild:electron": "electron-rebuild --version $(node -p \"require('electron/package.json').version\") --module-dir . --force --only better-sqlite3",
    "rebuild:native": "pnpm rebuild:electron",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "release:check": "node scripts/check-release-tag.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm bundle:check",
    "bundle:check": "node scripts/check-renderer-bundle.mjs",
    "test": "pnpm rebuild:node && vitest run; status=$?; pnpm rebuild:electron; exit $status",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.{js,mjs}\" \".github/workflows/*.{yml,yaml}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.{js,mjs}\" \".github/workflows/*.{yml,yaml}\" \"*.{ts,js,json}\""
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.4",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.3.4"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@electron/rebuild": "4.0.4",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.18.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
