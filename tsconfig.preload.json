{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts", "src/shared/**/*.d.ts"]
}
